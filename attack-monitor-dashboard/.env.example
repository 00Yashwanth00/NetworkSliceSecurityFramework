# Copy to .env and edit if your services run elsewhere. Restart `npm start` after changes.

# Where mitigation_dashboard.py (GET /api/dashboard-data) is running
DASHBOARD_BACKEND=http://localhost:8787

# Where mmt-core's REST API is running (proxied server-side, never called from browser JS)
MMT_CORE_URL=http://localhost:5000

# Optional: poll interval in ms (spec recommends 2000-3000)
REACT_APP_POLL_MS=2500

# Optional: if you deploy the built app and your backend is on another origin,
# set this to its base URL (the backend must then send CORS headers).
# REACT_APP_API_BASE=
